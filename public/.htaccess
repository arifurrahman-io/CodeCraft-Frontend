<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|meta-externalagent|Facebot|FacebookBot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot) [NC]
  RewriteRule ^blogs/([^/]+)/?$ share-meta.php?type=blog&slug=$1 [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|meta-externalagent|Facebot|FacebookBot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot) [NC]
  RewriteRule ^projects/([^/]+)/?$ share-meta.php?type=project&slug=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
